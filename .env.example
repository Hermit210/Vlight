# Supabase — create a project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=

# Helius — RPC + webhooks for syncing on-chain mint/list/buy events into
# asset_catalog. Not required until the marketplace/webhook sync task.
HELIUS_API_KEY=
